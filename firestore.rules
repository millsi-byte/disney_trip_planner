rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Personal space — your own devices only (back up + cross-device sync).
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared family space — everyone who joined the code.
    match /workspaces/{wid} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid));
      }
      allow get: if request.auth != null;        // verify a code before joining
      allow create: if request.auth != null;     // start a new family space
      allow update, delete: if isMember();

      // Each member self-adds (join) and self-removes (leave).
      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }

      // The shared data — only members can read/write.
      match /kv/{key} {
        allow read, write: if isMember();
      }
    }
  }
}
