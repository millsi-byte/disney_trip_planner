rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The one super-admin who authorizes everyone else.
    function isSuper() {
      return request.auth != null && request.auth.token.email == 'millsi@gmail.com';
    }
    // An authorized trip owner: the super-admin, or an email on the allowlist.
    function isOwner() {
      return request.auth != null &&
        (isSuper() || exists(/databases/$(database)/documents/owners/$(request.auth.token.email.lower())));
    }

    // Allowlist of trip owners. Anyone signed in can check; only super edits.
    match /owners/{email} {
      allow read: if request.auth != null;
      allow write: if isSuper();
    }

    // Email→workspace invite index for auto-join. An owner publishes one doc per
    // family member they add by email; that person reads their OWN email's doc on
    // sign-in to discover which workspace to join. Read is restricted to your own
    // email (or the super-admin) so invites can't be enumerated.
    match /invitesByEmail/{email} {
      allow read: if request.auth != null &&
        (isSuper() || request.auth.token.email.lower() == email);
      allow write: if isOwner();
    }

    // Personal space — your own devices (backup + profile + offline cache).
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The super-admin can enumerate every tenant for the console.
    match /workspaces/{wid=**} {
      allow list: if isSuper();
    }

    // Planning Parties (shared trips).
    match /workspaces/{wid} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid));
      }
      allow get: if request.auth != null;              // verify a code before joining
      allow create: if isOwner();                      // only authorized owners start a party
      allow update, delete: if isMember() || isSuper();

      // Each member self-adds (join) and self-removes (leave).
      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if (request.auth != null && request.auth.uid == uid) || isSuper();
      }

      // The shared data — members, or the super-admin (cross-tenant console).
      match /kv/{key} {
        allow read, write: if isMember() || isSuper();
      }
    }
  }
}
