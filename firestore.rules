rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The one super-admin who authorizes everyone else.
    function isSuper() {
      return request.auth != null && request.auth.token.email == 'millsi@gmail.com';
    }
    // An authorized trip owner: the super-admin, or an email on the allowlist.
    function isOwner() {
      return request.auth != null &&
        (isSuper() || exists(/databases/$(database)/documents/owners/$(request.auth.token.email.lower())));
    }

    // Allowlist of trip owners. Anyone signed in can check; only super edits.
    match /owners/{email} {
      allow read: if request.auth != null;
      allow write: if isSuper();
    }

    // Email→workspace invite index for auto-join. The same email can hold
    // invites from multiple tenants at once (one persona per group), so each
    // inviting owner writes their own subdoc and nobody can stomp another
    // owner's invite. The invited account reads its OWN email's full
    // subcollection on sign-in and self-joins each one it isn't already in.
    match /invitesByEmail/{email}/from/{wid} {
      allow read: if request.auth != null &&
        (isSuper() || request.auth.token.email.lower() == email);
      allow write: if isOwner();
    }

    // Personal space — your own devices (backup + profile + offline cache).
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The super-admin can enumerate every tenant for the console.
    match /workspaces/{wid=**} {
      allow list: if isSuper();
    }

    // Planning Parties (shared trips).
    match /workspaces/{wid} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid));
      }
      allow get: if request.auth != null;              // verify a code before joining
      allow create: if isOwner();                      // only authorized owners start a party
      allow update, delete: if isMember() || isSuper();

      // Each member self-adds (join) and self-removes (leave). The workspace
      // creator (owner) and the super-admin can also remove a member — that's
      // what lets an owner actually revoke a person they delete from their group.
      match /members/{uid} {
        allow read: if request.auth != null;
        allow create: if (request.auth != null && request.auth.uid == uid) || isSuper();
        allow delete: if (request.auth != null && request.auth.uid == uid) || isSuper()
          || (request.auth != null &&
              get(/databases/$(database)/documents/workspaces/$(wid)).data.by == request.auth.uid);
      }

      // The shared data — members, or the super-admin (cross-tenant console).
      match /kv/{key} {
        allow read, write: if isMember() || isSuper();
      }
    }
  }
}
