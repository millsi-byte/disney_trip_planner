rules_version = '2';
// ============================================================================
// PROPOSED hardened rules — NOT DEPLOYED. Audit findings F-05 (self-join hole)
// and related over-broad grants. Review, test against a THROWAWAY workspace
// with the emulator or the test account, then deploy with:
//     firebase deploy --only firestore:rules
// after renaming this file over firestore.rules.
//
// What changes vs the live rules (each marked CHANGED below):
//   1. members/{uid} create: self-join stays allowed, because the workspace id
//      IS the join code (C.joinParty does doc('workspaces/'+code)) — knowing
//      the wid is the credential, and requiring an invite doc would break
//      join-by-code entirely. The real fix already shipped app-side: new codes
//      are crypto-random 12-char (Build 346-dev). RESIDUAL RISK: workspaces
//      created before that may have short/guessable ids and cannot be renamed
//      (Firestore doc ids are immutable) — migrate old tenants to fresh ids if
//      this ever matters. A stricter invite-only variant is included below,
//      commented out, for if code-joins are ever retired.
//   2. workspace delete: previously ANY member could delete the whole tenant
//      doc. Now only the workspace creator (`by` field) or the super-admin.
//   3. invitesByEmail write: previously ANY authorized owner could write an
//      invite claiming to be "from" a workspace they don't own (spoofed-source
//      invites, and a way to stomp another owner's invite doc). Now the
//      writer must actually own that workspace. The invited account may
//      delete its own invite (post-join cleanup).
//   4. users/{uid} recursive grant is unchanged in effect but written
//      explicitly so future subcollections are a deliberate choice.
//
// What deliberately does NOT change:
//   - `get` on a workspace for any signed-in user: the join flow verifies a
//     code before the account is a member; removing this breaks joining.
//   - kv read/write for members: the app is a shared family whiteboard by
//     design; per-key ACLs would break every collection. (Per-item rules
//     arrive with the per-item sync engine — see docs/PER_ITEM_SYNC_DESIGN.md.)
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuper() {
      return request.auth != null && request.auth.token.email == 'millsi@gmail.com';
    }
    function isOwner() {
      return request.auth != null &&
        (isSuper() || exists(/databases/$(database)/documents/owners/$(request.auth.token.email.lower())));
    }

    match /owners/{email} {
      allow read: if request.auth != null;
      allow write: if isSuper();
    }

    match /invitesByEmail/{email}/from/{wid} {
      allow read: if request.auth != null &&
        (isSuper() || request.auth.token.email.lower() == email);
      // CHANGED (3): the inviter must own the workspace the invite points at.
      allow create, update: if isSuper() ||
        (isOwner() &&
         get(/databases/$(database)/documents/workspaces/$(wid)).data.by == request.auth.uid);
      // Inviter revokes, invited account self-cleans after joining, super always.
      allow delete: if isSuper() ||
        (request.auth != null && request.auth.token.email.lower() == email) ||
        (isOwner() &&
         get(/databases/$(database)/documents/workspaces/$(wid)).data.by == request.auth.uid);
    }

    // Personal space — backups, profile, offline cache. Own uid only.
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /workspaces/{wid=**} {
      allow list: if isSuper();
    }

    match /workspaces/{wid} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid));
      }
      function isCreator() {
        return request.auth != null && resource.data.by == request.auth.uid;
      }
      allow get: if request.auth != null;      // join flow verifies a code pre-membership
      allow create: if isOwner();
      allow update: if isMember() || isSuper();
      // CHANGED (2): deleting the tenant is creator-or-super, not any member.
      allow delete: if isCreator() || isSuper();

      match /members/{uid} {
        allow read: if request.auth != null;
        // (1) Self-join by code stays: addressing this path requires knowing
        // the wid, and the wid IS the join code (crypto-random since 346-dev).
        allow create: if (request.auth != null && request.auth.uid == uid) || isSuper();
        // Stricter variant if code-joins are ever retired (invite-only):
        // allow create: if isSuper() ||
        //   (request.auth != null && request.auth.uid == uid &&
        //    exists(/databases/$(database)/documents/invitesByEmail/$(request.auth.token.email.lower())/from/$(wid)));
        allow delete: if (request.auth != null && request.auth.uid == uid) || isSuper()
          || (request.auth != null &&
              get(/databases/$(database)/documents/workspaces/$(wid)).data.by == request.auth.uid);
      }

      match /kv/{key} {
        allow read, write: if isMember() || isSuper();
      }

      // Per-item sync engine (Build 350-dev): one doc per item + the
      // per-collection mode flags. Same trust boundary as kv — the workspace
      // is a shared family whiteboard. NOTE: the live rules do NOT have this
      // block, so the engine stays dormant in production (its flag reads
      // fail gracefully) until these rules are deployed.
      match /items/{itemId} {
        allow read, write: if isMember() || isSuper();
      }
      match /meta/{doc} {
        allow read, write: if isMember() || isSuper();
      }
    }
  }
}
